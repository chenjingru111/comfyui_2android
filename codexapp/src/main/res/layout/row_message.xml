<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/messageRole" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginBottom="3dp"
        android:textColor="@color/muted" android:textSize="11sp" />
    <TextView android:id="@+id/messageText" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:maxWidth="340dp" android:padding="12dp"
        android:textColor="@color/primary" android:textIsSelectable="true" android:textSize="15sp" />
</LinearLayout>
