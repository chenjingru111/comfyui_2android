<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_xs">

    <LinearLayout
        android:id="@+id/sectionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="4dp"
        android:paddingBottom="@dimen/space_xs"
        android:visibility="gone">

        <TextView
            android:id="@+id/sectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/groupSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inputCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inputLabel"
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/inputBadge"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_status"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/inputType"
            style="@style/MutedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="@dimen/space_sm" />

        <EditText
            android:id="@+id/inputText"
            style="@style/TextInput"
            android:inputType="text"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputTextarea"
            style="@style/TextInput"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="6"
            android:minLines="3"
            android:scrollbars="vertical"
            android:textSize="14sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputNumber"
            style="@style/TextInput"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:id="@+id/booleanRow">

            <TextView
                android:id="@+id/booleanState"
                style="@style/MutedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Switch
                android:id="@+id/inputBoolean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary" />
        </LinearLayout>

        <Spinner
            android:id="@+id/inputSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:minHeight="48dp"
            android:spinnerMode="dropdown"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mediaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/mediaValue"
                style="@style/MutedText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="2" />

            <Button
                android:id="@+id/inputMedia"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:minWidth="76dp"
                android:text="选择" />

            <Switch
                android:id="@+id/mediaSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
