<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:id="@+id/inputLabel"
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/inputType"
            style="@style/MutedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_md" />

        <EditText
            android:id="@+id/inputText"
            style="@style/TextInput"
            android:inputType="text"
            android:singleLine="true"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputTextarea"
            style="@style/TextInput"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputNumber"
            style="@style/TextInput"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/inputBoolean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            android:text="启用"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/inputSelect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:spinnerMode="dropdown"
            android:visibility="gone" />

        <Button
            android:id="@+id/inputMedia"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
