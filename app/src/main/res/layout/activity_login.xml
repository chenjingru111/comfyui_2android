<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">
        <TextView
            style="@style/AppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/app_name" />
        <TextView
            style="@style/MutedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_xl"
            android:text="@string/login_subtitle" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">
            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_url" />
            <EditText
                android:id="@+id/serverInput"
                style="@style/TextInput"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="http://192.168.4.6:8765"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:singleLine="true" />
            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/username" />
            <EditText
                android:id="@+id/usernameInput"
                style="@style/TextInput"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="admin"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLength="64"
                android:singleLine="true" />
            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/password" />
            <EditText
                android:id="@+id/passwordInput"
                style="@style/TextInput"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:singleLine="true" />
            <Switch
                android:id="@+id/vpnSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:buttonTint="@color/primary"
                android:text="@string/use_server_vpn"
                android:textColor="@color/text_primary" />
            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/vpn_hint" />
            <Button
                android:id="@+id/loginButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/login" />
            <ProgressBar
                android:id="@+id/loginProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone" />
            <TextView
                android:id="@+id/loginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/error" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
